# Copy to .env and fill in. NEVER commit .env.

# --- Application ---
APP_NAME=AgentCare
ENVIRONMENT=development
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./data/agentcare.db
# Postgres:
# DATABASE_URL=postgresql+psycopg://agentcare:changeme@localhost:5432/agentcare

# --- LangGraph checkpointer (persistent agent state) ---
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# ===========================================================================
# LLM  —  pick ONE provider, set its key, set a matching model.
# Verify with:  python -m scripts.check_llm
# ===========================================================================
# groq | openai | anthropic | gemini | openrouter | ollama | custom
LLM_PROVIDER=groq

LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# Only the key matching LLM_PROVIDER needs a value. Leave the rest blank.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Provider "custom": any OpenAI-compatible endpoint (vLLM, Together, LM Studio…)
LLM_API_KEY=
LLM_BASE_URL=

# ---------------------------------------------------------------------------
# Provider cheat sheet — model ids change, so confirm with scripts/check_llm.py
#
#   LLM_PROVIDER=groq        free tier, fastest. Console: console.groq.com
#   LLM_PROVIDER=openai      set OPENAI_API_KEY, e.g. LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=anthropic   set ANTHROPIC_API_KEY, model id from the console
#   LLM_PROVIDER=gemini      set GOOGLE_API_KEY, free tier at aistudio.google.com
#   LLM_PROVIDER=openrouter  one key, many models: LLM_MODEL=meta-llama/llama-3.3-70b-instruct
#   LLM_PROVIDER=ollama      fully local, NO KEY. Run `ollama pull llama3.1`
#                            then LLM_MODEL=llama3.1 and LLM_BASE_URL is preset.
# ---------------------------------------------------------------------------

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Documents ---
DOCUMENT_STORAGE_DIR=./storage/documents
MAX_DOCUMENT_MB=10
